binder_call(system_server, vendor_hal_displayfeature_xiaomi_default)

allow system_server sysfs_batteryinfo:dir r_dir_perms;
allow system_server sysfs_batteryinfo:file rw_file_perms;

allow system_server vendor_sysfs_battery_supply:dir r_dir_perms;
allow system_server vendor_sysfs_battery_supply:file rw_file_perms;

allow system_server vendor_sysfs_power_supply:dir r_dir_perms;
allow system_server vendor_sysfs_power_supply:file rw_file_perms;

allow system_server vendor_sysfs_graphics:file rw_file_perms;