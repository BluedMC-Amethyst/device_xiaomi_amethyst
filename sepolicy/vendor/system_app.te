allow system_app self:netlink_kobject_uevent_socket { create bind read setopt getopt };

allow system_app sysfs_thermal:dir r_dir_perms;
allow system_app sysfs_thermal:file rw_file_perms;
allow system_app property_socket:sock_file { write };
allow system_app proc_stat:file { read open getattr };
allow system_app init:unix_stream_socket connectto;
allow system_app vendor_sysfs_graphics:file rw_file_perms;
set_prop(system_app, exported_system_prop)
set_prop(system_app, system_prop)

allow system_app {
  batteryproperties_service
  batterystats_service
  vibrator_manager_service
}:service_manager find;

# Gestures
allow system_app vendor_sysfs_sensors:file rw_file_perms;

# Battery
allow system_app vendor_sysfs_power_supply:file rw_file_perms;
allow system_app vendor_sysfs_power_supply:dir r_dir_perms;
allow system_app vendor_sysfs_battery_supply:file rw_file_perms;
allow system_app vendor_sysfs_battery_supply:dir r_dir_perms;
allow system_app vendor_sysfs_qcom_battery:file rw_file_perms;
allow system_app vendor_sysfs_qcom_battery:dir r_dir_perms;
allow system_app vendor_sysfs_qcom_battery:dir search;
allow system_app vendor_sysfs_usb_supply:file r_file_perms;
allow system_app vendor_sysfs_usb_supply:dir r_dir_perms;