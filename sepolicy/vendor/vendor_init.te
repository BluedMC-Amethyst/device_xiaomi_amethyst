set_prop(vendor_init,audio_prop)
set_prop(vendor_init, vendor_deviceid_prop)
set_prop(vendor_init, vendor_media_performance_class)
set_prop(vendor_init, vendor_mischeck_prop)

allow vendor_init device:chr_file { getattr };
allow vendor_init vendor_sysfs_touch:file { w_file_perms setattr };
allow vendor_init vendor_miev_device:chr_file getattr;

allow vendor_init {
    proc_watermark_scale_factor
    proc_watermark_boost_factor
}:file w_file_perms;
